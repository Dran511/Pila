# Copy to .env for local overrides. Everything is optional in development.

# Postgres connection string. Leave empty to use the built-in embedded database (PGlite),
# which stores data in ./.data and needs no installation.
DATABASE_URL=

# Secret used to sign login sessions. REQUIRED in production (any long random string).
JWT_SECRET=

# Port for the API server (the Vite dev server proxies to it).
PORT=3001

# Create the demo office (demo@pila.app logins) on startup.
SEED_DEMO=true
